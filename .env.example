# Copy this file to .env and replace the placeholders with your own credentials.
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_WORKSPACE_ID=your_bailian_workspace_id
DASHSCOPE_API_HOST=your_bailian_workspace_id.cn-beijing.maas.aliyuncs.com
DASHSCOPE_OPENAI_BASE_URL=https://your_bailian_workspace_id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_BASE_URL=https://your_bailian_workspace_id.cn-beijing.maas.aliyuncs.com/compatible-api/v1
LLM_MODEL=qwen3.7-max-preview
EMBEDDING_MODEL=text-embedding-v4
RERANK_MODEL=qwen3-rerank
